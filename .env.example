# ============================================
# EcoQuest — Environment Variables Template
# ============================================

# ----- PostgreSQL Database Config -----
POSTGRES_USER=ecoquest
POSTGRES_PASSWORD=ecoquest
POSTGRES_DB=ecoquest
DATABASE_URL=postgresql+asyncpg://ecoquest:ecoquest@postgres:5432/ecoquest

# ----- Application Settings -----
ENVIRONMENT=development
LOG_LEVEL=DEBUG
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_256_BIT_STRING
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- Third-Party Services (Optional / Configured in app) -----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=100
LOGIN_RATE_LIMIT_PER_MINUTE=5

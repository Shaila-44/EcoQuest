# ============================================
# EcoQuest API — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================

# ----- Database -----
POSTGRES_USER=ecoquest
POSTGRES_PASSWORD=ecoquest_dev
POSTGRES_DB=ecoquest
# NOTE: docker-compose's `env_file:` does NOT expand ${VAR} references inside
# this file — keep DATABASE_URL a fully-resolved literal URL that matches
# POSTGRES_USER/PASSWORD/DB above (host "postgres" for docker-compose,
# "localhost" if running the API outside Docker against a local Postgres).
DATABASE_URL=postgresql+asyncpg://ecoquest:ecoquest_dev@postgres:5432/ecoquest

# ----- Auth -----
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_256_BIT_STRING
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# RS256 keypair for JWT signing (PEM, with literal \n line breaks, single-quoted).
# REQUIRED for any real deployment: without these, app/core/security.py
# auto-generates an ephemeral keypair per process, which invalidates every
# issued JWT (i.e. logs everyone out) on every restart/redeploy.
# Generate with:
#   python -c "from cryptography.hazmat.primitives import serialization; from cryptography.hazmat.primitives.asymmetric import rsa; k=rsa.generate_private_key(public_exponent=65537, key_size=2048); print(k.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption()).decode().replace(chr(10), '\\\\n')); print(k.public_key().public_bytes(serialization.Encoding.PEM, serialization.PublicFormat.SubjectPublicKeyInfo).decode().replace(chr(10), '\\\\n'))"
RSA_PRIVATE_KEY=
RSA_PUBLIC_KEY=

# ----- AI Pipeline -----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ----- Storage (Cloudinary) -----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----- Application -----
ENVIRONMENT=development
LOG_LEVEL=DEBUG
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5175

# ----- Rate Limiting -----
RATE_LIMIT_PER_MINUTE=100
LOGIN_RATE_LIMIT_PER_MINUTE=5
